[Unit]
Description=Agente Contable EasyTic — panel web + scheduler
Documentation=https://github.com/algalanperez/easytic
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__PYTHON__ __INSTALL_DIR__/main.py --serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agente-contable

# Hardening básico
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
