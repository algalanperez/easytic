# API de Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 — descarga credentials.json desde Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# IDs de carpetas en Google Drive (opcional; si se deja vacío, busca en todo Drive)
DRIVE_FOLDER_FACTURAS_EMITIDAS=
DRIVE_FOLDER_FACTURAS_RECIBIDAS=

# Etiqueta de Gmail donde llegan facturas de proveedores (opcional)
GMAIL_LABEL_FACTURAS=facturas

# Datos de la empresa (para rellenar modelos fiscales)
EMPRESA_NIF=B12345678
EMPRESA_NOMBRE=EasyTic Solutions SL
EMPRESA_EJERCICIO=2025

# Panel web
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Autenticación HTTP Basic — dejar vacío para deshabilitar (solo en dev local)
WEB_USER=admin
WEB_PASS=cambia_esta_contraseña

# Directorio de exportaciones XML/JSON/CSV
EXPORT_DIR=exports

# Notificaciones email (SMTP) — dejar vacío para deshabilitar
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contabilidad@easytic.es
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=contabilidad@easytic.es
# Destinatarios separados por comas
NOTIFY_TO=gerencia@easytic.es,contable@easytic.es
